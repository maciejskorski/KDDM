 = load_digits()\nX, y = digits.data, digits.target\n\npca = PCA(n_components=2)\nX2 = pca.fit_transform(X)\n\nfig, ax = plt.subplots(figsize=(8, 6))\nscatter = ax.scatter(X2[:, 0], X2[:, 1], c=y, cmap='tab10', alpha=0.5, s=10)\nplt.colorbar(scatter, ax=ax, label='Digit')\nax.set_title(f'PCA of handwritten digits — 2 components explain {pca.explained_variance_ratio_.sum():.0%} of variance')\nax.set_xlabel('PC1')\nax.set_ylabel('PC2')\nplt.tight_layout()\nplt.savefig('pca_digits.png', dpi=150, bbox_inches='tight')\nplt.show()","visibility":"hide","key":"fjA2gjunbi"},{"type":"outputs","id":"jKidGYHteMgzsz8UAaySp","children":[],"visibility":"show","key":"y2LL3oc67d"}],"data":{"tags":[]},"visibility":"show","key":"jkj3YXC9oi"},{"type":"block","children":[{"type":"admonition","kind":"note","children":[{"type":"admonitionTitle","children":[{"type":"text","value":"Note","key":"u4kuOpWaZK"}],"key":"XMLXaMgjcV"},{"type":"paragraph","position":{"start":{"line":276,"column":1},"end":{"line":276,"column":1}},"children":[{"type":"text","value":"PCA is covered in depth later in the course.","position":{"start":{"line":276,"column":1},"end":{"line":276,"column":1}},"key":"q9YrZDZR86"}],"key":"jC44rN5mIx"}],"key":"XeFzkIB4jv"},{"type":"container","kind":"figure","children":[{"type":"container","kind":"figure","subcontainer":true,"children":[{"type":"image","url":"/KDDM/build/pca_digits-e4067be33e673d5ccd50877c5ceb78be.png","width":"80%","key":"qQBpmkkdW0","urlSource":"pca_digits.png","urlOptimized":"/KDDM/build/pca_digits-e4067be33e673d5ccd50877c5ceb78be.webp"},{"type":"caption","children":[{"type":"paragraph","children":[{"type":"captionNumber","kind":"figure","label":"fig-pca-digits-a","identifier":"fig-pca-digits-a","html_id":"fig-pca-digits-a","enumerator":"3a","children":[{"type":"text","value":"(","key":"BjSdR9M8J9"},{"type":"text","value":"a","key":"FczhLbRMad"},{"type":"text","value":")","key":"szIQlXRxeU"}],"template":"({subEnumerator})","key":"eNDzwQR5gA"}],"key":"lwfp7dX